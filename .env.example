# Leave keys blank for offline fixture mode. Never commit a populated .env.
MODEL_API_KEY=
MODEL_MODEL=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_PROTOCOL=responses
MODEL_TIMEOUT=60
EXTRACT_MODEL=
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_PROTOCOL=
DRAFT_MODEL=
DRAFT_BASE_URL=
DRAFT_API_KEY=
DRAFT_PROTOCOL=
# Redact follows MODEL_* unless Baseten is configured. Explicit REDACT_* wins.
BASETEN_BASE_URL=
BASETEN_API_KEY=
REDACT_MODEL=
REDACT_BASE_URL=
REDACT_API_KEY=
REDACT_PROTOCOL=
VOICE_MODEL=muse-voice-transcribe-1.0
VOICE_BASE_URL=https://api.meta.ai/v1
VOICE_API_KEY=
# Set true to force ALL steps offline, including eval/test runs.
PAYOPS_MOCK=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_TIMEOUT=30
LLM_PROVIDER=sarvam
AUTO_RESOLVE_THRESHOLD=0.95
HUMAN_REVIEW_THRESHOLD=0.70
HIGH_VALUE_THRESHOLD=50000
WRITE_OFF_LIMIT=5000
# Optional SQLite file override; default runtime/payops.sqlite3
PAYOPS_DB=
